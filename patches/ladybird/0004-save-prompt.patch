diff --git a/UI/Qt/CredentialsPrompt.cpp b/UI/Qt/CredentialsPrompt.cpp
new file mode 100644
--- /dev/null
+++ b/UI/Qt/CredentialsPrompt.cpp
@@ -0,0 +1,62 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include "CredentialsPrompt.h"
+
+#include <QMessageBox>
+#include <QPushButton>
+
+static Ladybird::CredentialsBridgeDelegate* s_credentials_bridge_delegate { nullptr };
+
+namespace Ladybird {
+
+void set_credentials_bridge_delegate(CredentialsBridgeDelegate* delegate)
+{
+    s_credentials_bridge_delegate = delegate;
+}
+
+CredentialsBridgeDelegate* credentials_bridge_delegate()
+{
+    return s_credentials_bridge_delegate;
+}
+
+static QString qstring_from(AK::String const& string)
+{
+    auto bytes = string.to_byte_string();
+    return QString::fromUtf8(bytes.characters(), static_cast<qsizetype>(bytes.bytes().size()));
+}
+
+void show_save_credentials_prompt(QWidget& parent, Web::CredentialsSaveRequestPayload const& payload)
+{
+    auto* bridge = credentials_bridge_delegate();
+    if (!bridge || !bridge->should_offer(payload))
+        return; // no vault linked, or the delegate declines: never show a dead-end prompt
+
+    auto* dialog = new QMessageBox(&parent);
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    dialog->setWindowTitle(QStringLiteral("Save password?"));
+    dialog->setText(QStringLiteral("Save the password for %1?").arg(qstring_from(payload.frame_origin)));
+
+    auto* save = dialog->addButton(QStringLiteral("Save"), QMessageBox::AcceptRole);
+    auto* not_now = dialog->addButton(QStringLiteral("Not now"), QMessageBox::RejectRole);
+    auto* never = dialog->addButton(QStringLiteral("Never for this site"), QMessageBox::DestructiveRole);
+
+    QObject::connect(dialog, &QDialog::finished, dialog, [dialog, save, not_now, never, payload](int) {
+        auto* clicked = dialog->clickedButton();
+        CredentialsPromptOutcome outcome = CredentialsPromptOutcome::Dismissed;
+        if (clicked == save)
+            outcome = CredentialsPromptOutcome::Saved;
+        else if (clicked == not_now)
+            outcome = CredentialsPromptOutcome::NotNow;
+        else if (clicked == never)
+            outcome = CredentialsPromptOutcome::NeverForSite;
+        if (auto* delegate = credentials_bridge_delegate())
+            delegate->did_decide(payload, outcome);
+    });
+    dialog->open();
+}
+
+}
diff --git a/UI/Qt/CredentialsPrompt.h b/UI/Qt/CredentialsPrompt.h
new file mode 100644
--- /dev/null
+++ b/UI/Qt/CredentialsPrompt.h
@@ -0,0 +1,41 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/HTML/CredentialsSaveRequestPayload.h>
+
+class QWidget;
+
+namespace Ladybird {
+
+// The save prompt presents Save / Not now / Never for this site and hands the
+// outcome to the vault-backed delegate. The delegate seam keeps the UI patch
+// self-contained: whoever links the credentials bridge library registers an
+// implementation (see ladybird-keychain-bridge CredentialService::on_prompt_result).
+enum class CredentialsPromptOutcome {
+    Saved,
+    NotNow,
+    NeverForSite,
+    Dismissed,
+};
+
+class CredentialsBridgeDelegate {
+public:
+    virtual ~CredentialsBridgeDelegate() = default;
+    virtual void did_decide(Web::CredentialsSaveRequestPayload const&, CredentialsPromptOutcome) = 0;
+
+    // Gate the offer before any dialog opens (never-for-this-site lists, empty
+    // payloads). Default: always offer.
+    virtual bool should_offer(Web::CredentialsSaveRequestPayload const&) { return true; }
+};
+
+void set_credentials_bridge_delegate(CredentialsBridgeDelegate*);
+CredentialsBridgeDelegate* credentials_bridge_delegate();
+
+void show_save_credentials_prompt(QWidget& parent, Web::CredentialsSaveRequestPayload const& payload);
+
+}
