new file mode 100644
index 00000000..d1d15182
--- /dev/null
+++ b/Tests/WebContent/TestCredentialsIpc.cpp
@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Message.h>
+#include <LibTest/TestCase.h>
+#include <LibURL/Origin.h>
+#include <LibWebView/CredentialSuggestion.h>
+#include <LibWeb/HTML/CredentialsSaveRequestPayload.h>
+#include <LibWebCommon/Page/PageId.h>
+#include <WebContent/WebContentClientEndpoint.h>
+#include <WebContent/WebContentServerEndpoint.h>
+
+TEST_CASE(save_credentials_message_encodes)
+{
+    Web::CredentialsSaveRequestPayload payload {
+        .top_level_origin = "https://top.example"_string,
+        .frame_origin = "https://inner.example"_string,
+        .submit_action_origin = "https://inner.example"_string,
+        .username = "alice"_string,
+        .secret = "hunter2"_string,
+        .field_scope = "username_password"_string,
+        .frame_id = Web::HTML::CrossProcessId { .namespace_id = 1, .local_id = 2 },
+    };
+
+    auto encoded = MUST(Messages::WebContentClient::DidRequestSaveCredentials::static_encode(Web::PageId { 1 }, payload));
+    EXPECT(encoded.span().size() > 0);
+}
+
+TEST_CASE(credential_selected_message_encodes)
+{
+    WebView::CredentialSuggestion suggestion { .suggestion_id = 42, .username = "alice"_utf16, .secret = "hunter2"_utf16 };
+    auto encoded = MUST(Messages::WebContentServer::CredentialSelected::static_encode(Web::PageId { 1 }, suggestion));
+    EXPECT(encoded.span().size() > 0);
+}
