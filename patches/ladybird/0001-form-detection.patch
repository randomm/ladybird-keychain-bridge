+
+static bool looks_like_username_field(HTMLInputElement const& input)
+{
+    if (input.type_state() == HTMLInputElement::TypeAttributeState::Password)
+        return false;
+    if (input.parse_autocomplete_attribute().field_name == "username"_utf16)
+        return true;
+    auto const name = input.name();
+    return name == "username"_utf16 || name == "user"_utf16 || name == "email"_utf16;
+}
+
+Optional<CredentialsSaveRequestPayload> HTMLFormElement::credentials_save_request_payload(HTMLFormElement const& form)
+{
+    Optional<Utf16String> username;
+    Optional<Utf16String> secret;
+
+    auto const controls = form.elements();
+    for (size_t i = 0; i < controls->length(); ++i) {
+        auto* element = controls->item(i);
+        if (!is<HTMLInputElement>(element))
+            continue;
+        auto const& input = static_cast<HTMLInputElement const&>(*element);
+        if (input.type_state() == HTMLInputElement::TypeAttributeState::Password)
+            secret = input.value();
+        else if (looks_like_username_field(input))
+            username = input.value();
+    }
+
+    if (!secret.has_value() || secret->is_empty())
+        return {};
+
+    CredentialsSaveRequestPayload payload;
+    payload.field_scope = username.has_value() ? "username_password"_string : "password_only"_string;
+    payload.username = username.has_value() ? String::from_utf8(username->to_byte_string()) : String {};
+    payload.secret = String::from_utf8(secret->to_byte_string());
+    auto& document = form.document();
+    payload.frame_origin = document.origin().serialize();
+    // https://w3c.github.io/webappsec-credential-management/#submit-action-origin:
+    // the form's action attribute resolved against the document base URL; an
+    // absent action resolves to the document URL.
+    URL::URL action_url = document.url();
+    if (auto action_attribute = get_attribute_ns({}, AttributeNames::action); action_attribute.has_value()) {
+        if (auto parsed = URL::Parser::basic_parse(*action_attribute, document.base_url()); parsed.has_value())
+            action_url = parsed.release_value();
+    }
+    payload.submit_action_origin = action_url.origin().serialize();
+    if (auto top_level = document.relevant_settings_object().top_level_origin; top_level.has_value())
+        payload.top_level_origin = top_level->serialize();
+    else
+        payload.top_level_origin = payload.frame_origin;
+    if (auto navigable = document.navigable())
+        payload.frame_id = navigable->id();
+    return payload;
 }
 
