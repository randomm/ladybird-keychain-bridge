diff --git a/Tests/LibWeb/TestLoginFormDetection.cpp b/Tests/LibWeb/TestLoginFormDetection.cpp
new file mode 100644
--- /dev/null
+++ b/Tests/LibWeb/TestLoginFormDetection.cpp
@@ -0,0 +1,132 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibTest/TestCase.h>
+#include <LibWeb/Bindings/MainThreadVM.h>
+#include <LibWeb/Bindings/PrincipalHostDefined.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/AttributeNames.h>
+#include <LibWeb/HTML/CredentialsSaveRequestPayload.h>
+#include <LibWeb/HTML/HTMLDocument.h>
+#include <LibWeb/HTML/HTMLFormElement.h>
+#include <LibWeb/HTML/HTMLInputElement.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Platform/FontPlugin.h>
+
+static GC::Ref<Web::DOM::Document> create_document()
+{
+    static Web::Platform::FontPlugin font_plugin { false };
+    static bool font_plugin_installed = false;
+    if (!font_plugin_installed) {
+        Web::Platform::FontPlugin::install(font_plugin);
+        font_plugin_installed = true;
+    }
+    auto realm = Web::Bindings::create_a_principal_javascript_realm();
+    auto* window = Web::HTML::window_from_global_object(realm->global_object());
+    VERIFY(window);
+    auto document = Web::HTML::HTMLDocument::create(Web::Bindings::principal_host_defined_page(*realm), *window);
+    document->set_document_type(Web::DOM::Document::Type::HTML);
+    document->set_window(*window);
+    window->set_associated_document(document);
+    auto root = MUST(document->create_element("html"_utf16, Web::Bindings::ElementCreationOptions {}));
+    MUST(document->append_child(root));
+    return document;
+}
+
+static GC::Ref<Web::DOM::Element> add_form(GC::Ref<Web::DOM::Document> document)
+{
+    auto form = MUST(document->create_element("form"_utf16, Web::Bindings::ElementCreationOptions {}));
+    MUST(document->document_element()->append_child(form));
+    return form;
+}
+
+static void add_input(Web::DOM::Element& parent, Utf16View type, Utf16View name, Utf16View value)
+{
+    auto& document = parent.document();
+    auto input = MUST(document.create_element("input"_utf16, Web::Bindings::ElementCreationOptions {}));
+    MUST(input->set_attribute(Web::HTML::AttributeNames::type, type));
+    MUST(input->set_attribute(Web::HTML::AttributeNames::name, name));
+    MUST(static_cast<Web::HTML::HTMLInputElement&>(*input).set_value(value));
+    MUST(parent.append_child(input));
+}
+
+TEST_CASE(username_and_password_form_yields_full_payload)
+{
+    auto document = create_document();
+    auto form = add_form(document);
+    add_input(form, "text"_utf16, "username"_utf16, "alice"_utf16);
+    add_input(form, "password"_utf16, "password"_utf16, "hunter2"_utf16);
+
+    auto payload = Web::HTML::HTMLFormElement::credentials_save_request_payload(
+        static_cast<Web::HTML::HTMLFormElement&>(*form));
+    EXPECT(payload.has_value());
+    if (payload.has_value()) {
+        EXPECT_EQ(payload->field_scope, "username_password"_string);
+        EXPECT_EQ(payload->username, "alice"_string);
+        EXPECT_EQ(payload->secret, "hunter2"_string);
+        EXPECT(!payload->frame_origin.is_empty());
+        EXPECT_EQ(payload->submit_action_origin, payload->frame_origin);
+        EXPECT(!payload->top_level_origin.is_empty());
+    }
+}
+
+TEST_CASE(password_only_form_yields_password_only_scope)
+{
+    auto document = create_document();
+    auto form = add_form(document);
+    add_input(form, "password"_utf16, "password"_utf16, "solo"_utf16);
+
+    auto payload = Web::HTML::HTMLFormElement::credentials_save_request_payload(
+        static_cast<Web::HTML::HTMLFormElement&>(*form));
+    EXPECT(payload.has_value());
+    if (payload.has_value()) {
+        EXPECT_EQ(payload->field_scope, "password_only"_string);
+        EXPECT(payload->username.is_empty());
+        EXPECT_EQ(payload->secret, "solo"_string);
+    }
+}
+
+TEST_CASE(form_without_password_yields_no_payload)
+{
+    auto document = create_document();
+    auto form = add_form(document);
+    add_input(form, "text"_utf16, "q"_utf16, "search terms"_utf16);
+
+    auto payload = Web::HTML::HTMLFormElement::credentials_save_request_payload(
+        static_cast<Web::HTML::HTMLFormElement&>(*form));
+    EXPECT(!payload.has_value());
+}
+
+TEST_CASE(empty_password_form_yields_no_payload)
+{
+    auto document = create_document();
+    auto form = add_form(document);
+    add_input(form, "text"_utf16, "username"_utf16, "alice"_utf16);
+    add_input(form, "password"_utf16, "password"_utf16, ""_utf16);
+
+    auto payload = Web::HTML::HTMLFormElement::credentials_save_request_payload(
+        static_cast<Web::HTML::HTMLFormElement&>(*form));
+    EXPECT(!payload.has_value());
+}
+
+TEST_CASE(action_attribute_sets_submit_action_origin)
+{
+    auto document = create_document();
+    auto form = add_form(document);
+    MUST(form->set_attribute(Web::HTML::AttributeNames::action, "https://evil.example/login"_utf16));
+    add_input(form, "text"_utf16, "username"_utf16, "alice"_utf16);
+    add_input(form, "password"_utf16, "password"_utf16, "hunter2"_utf16);
+
+    auto payload = Web::HTML::HTMLFormElement::credentials_save_request_payload(
+        static_cast<Web::HTML::HTMLFormElement&>(*form));
+    EXPECT(payload.has_value());
+    if (payload.has_value()) {
+        // The save is bound to where the password actually goes, not merely to
+        // where the page came from: a cross-origin action must be visible here.
+        EXPECT_EQ(payload->submit_action_origin, "https://evil.example"_string);
+        EXPECT_NE(payload->submit_action_origin, payload->frame_origin);
+    }
+}
