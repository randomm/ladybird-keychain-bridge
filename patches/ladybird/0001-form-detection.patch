+#pragma once
+
+#include <AK/String.h>
+#include <LibWebCommon/HTML/CrossProcessId.h>
+
+namespace Web {
+
+// Carried from WebContent to the UI when the credentials bridge wants the user
+// offered a save. Field names mirror the bridge SaveRequest payload verbatim.
+struct CredentialsSaveRequestPayload {
+    String top_level_origin;
+    String frame_origin;
+    String submit_action_origin;
+    String username;
+    String secret;
+    String field_scope; // "username_password" | "password_only"
+    HTML::CrossProcessId frame_id;
+};
+
+}
